{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "noslow": ["../../src/index.ts"]
    }
  },
  "ts-node": {
    "paths": true
  },
  "include": ["src/**/*"]
}
